<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>WakeGuard.Tray</AssemblyName>
    <RootNamespace>WakeGuard.Tray</RootNamespace>
    <Product>WakeGuard</Product>
    <Description>Keep Windows working after the display turns off or the session is locked.</Description>
    <Authors>WakeGuard contributors</Authors>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\WakeGuard.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\WakeGuard.Contracts\WakeGuard.Contracts.csproj" />
    <ProjectReference Include="..\WakeGuard.Windows\WakeGuard.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="WakeGuard.Windows.Tests" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\TrayInactive.ico" LogicalName="WakeGuard.Tray.Assets.TrayInactive.ico" />
    <EmbeddedResource Include="Assets\TrayKeepAwake.ico" LogicalName="WakeGuard.Tray.Assets.TrayKeepAwake.ico" />
    <EmbeddedResource Include="Assets\TrayDisplayOn.ico" LogicalName="WakeGuard.Tray.Assets.TrayDisplayOn.ico" />
  </ItemGroup>
</Project>
